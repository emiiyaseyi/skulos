APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The base domain every school subdomain hangs off ({slug}.APP_DOMAIN),
# per Route::domain('{school}.'.$domain) in routes/web.php. Locally
# *.localhost resolves automatically with no setup; in production this
# must be the real domain, with wildcard DNS and a wildcard (or per
# subdomain) SSL certificate already covering it — see DEPLOYMENT.md,
# "Linking a created school to a subdomain in cPanel".
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Which connection each school's own tenant database uses. Defaults to
# whatever DB_CONNECTION above is (sqlite locally). Production must set
# this to mysql explicitly (see DEPLOYMENT.md), the platform database and
# every school's tenant database both run on MySQL there.
# TENANCY_DRIVER=mysql
# TENANCY_DB_PREFIX=skulos_school_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local dev: keep null (per-host cookies). A leading-dot .localhost value is rejected by browsers and breaks login (419). Production with real subdomains can use .yourdomain.tld to share the session.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Single sign on (Google, Microsoft/Outlook). Off unless enabled AND credentials set.
SSO_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

SSO_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# Platform support contact shown across the app, admin editable afterward
# from Admin > Settings > Support Contact. Commented out on purpose: the
# values shown are already the real code default (config/skulos.php), so
# leaving this unset changes nothing — only uncomment to override it.
# SKULOS_SUPPORT_EMAIL=info@skulosapp.com
# SKULOS_SUPPORT_PHONE="+234 802 337 3302"

# The bank account schools transfer subscription payments into. Has no
# safe default (blank until set) — a leaked real account name/number is
# scam usable, so this must never be a committed value anywhere, only set
# directly on the production server's own .env.
SKULOS_SUBSCRIPTION_BANK_NAME=
SKULOS_SUBSCRIPTION_ACCOUNT_NAME=
SKULOS_SUBSCRIPTION_ACCOUNT_NUMBER=

# Idle session security timeout, seconds. Admin editable afterward from
# Settings > Idle Timeout (platform default, per school override).
# Commented out: the values shown are the real code default, only
# uncomment to override it before any admin has configured one.
# SESSION_IDLE_SECONDS=30
# SESSION_IDLE_WARNING_SECONDS=15

# Retention windows (days) for data that grows unbounded, per the
# standing "Database & Storage Efficiency Rules." Admin editable
# afterward the same way idle timeout is. Commented out: shown values
# are the real code default.
# RETENTION_NOTIFICATIONS_DAYS=90
# RETENTION_COMMUNICATION_LOGS_DAYS=180
# RETENTION_SESSIONS_DAYS=30

# Where audit log durable exports are written (config/skulos.php,
# audit-logs:export). 'local' works but is not truly immutable; pointing
# this at 's3' with Object Lock/versioning enabled on the bucket is what
# makes it genuinely write-once-read-many. That bucket policy is set at
# the infrastructure level, not by this app. Commented out: 'local' is
# already the real code default.
# AUDIT_LOG_EXPORT_DISK=local

# Self hosted licensing: only relevant for a single school running its
# own dedicated copy of this app on its own server, see DEPLOYMENT.md's
# "Self-hosted deployment" section. Leave commented out (false) on
# SKULOS's own multi-tenant production hosting.
# SKULOS_SELF_HOSTED=true
# SKULOS_LICENSE_ENDPOINT=https://skulosapp.com/api/license/verify
# SKULOS_LICENSE_GRACE_DAYS=14

# cPanel-API-based database provisioning: only needed on shared cPanel
# hosting where the MySQL user cannot be granted global CREATE DATABASE
# privilege (see config/tenancy.php's own docblock). Leave commented
# out entirely on a host where the MySQL user already has that
# privilege (e.g. a VPS). TENANCY_DB_PREFIX above must be set to match
# cPanel's own naming convention ("{cpanel_username}_") when this is on.
# CPANEL_API_ENABLED=true
# CPANEL_HOST=your-server-hostname.example.com
# CPANEL_PORT=2083
# CPANEL_USERNAME=your_cpanel_username
# CPANEL_API_TOKEN=
# CPANEL_DB_USER=your_cpanel_username_dbuser
